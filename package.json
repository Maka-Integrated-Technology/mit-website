{
  "name": "vite-react-router-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run security:verify-configs && react-router build && npm run security:verify-configs",
    "dev": "react-router dev -p 5100",
    "start": "npx serve build/client -s",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:verify-configs": "node scripts/security/config-integrity.mjs verify",
    "security:snapshot-configs": "node scripts/security/config-integrity.mjs snapshot",
    "audit:dependencies": "node scripts/security/dependency-audit-policy.mjs",
    "test:audit-policy": "node scripts/security/dependency-audit-policy.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/playfair-display": "^5.1.1",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.18.4",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "universal-cookie": "^8.1.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rr-next-routes": "^0.0.10",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "baseline-browser-mapping": "2.11.27",
    "body-parser@1": "1.20.6",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "browserslist": "4.29.3",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "hono": "4.13.12",
    "ip-address": "10.7.3",
    "js-yaml@4": "4.3.2",
    "qs": "6.16.0",
    "valibot": "1.5.0"
  }
}
